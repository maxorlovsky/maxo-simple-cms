{
  "name": "maxo-simple-cms",
  "description": "Maxo's Simple CMS",
  "version": "6.0.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxorlovsky/maxo-simple-cms"
  },
  "workspaces": [
    "ui",
    "api"
  ],
  "scripts": {
    "ui:lint": "cd ui && npm run eslint && npm run tsc",
    "ui:build": "npm install && cd ui && npm run build",
    "ui": "cd ui && npm run ui",
    "api:lint": "eslint --no-warn-ignored ./api/src/**/*.ts",
    "api:release": "cd api && npm run release",
    "api": "cd api && npm run api",
    "clean-branches": "git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@typescript-eslint/parser": "8.45.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/compiler-sfc": "3.5.22",
    "@vueuse/core": "13.9.0",
    "axios": "1.12.2",
    "bcrypt": "6.0.0",
    "date-fns": "4.1.0",
    "eslint": "9.36.0",
    "eslint-plugin-vue": "9.33.0",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "floating-vue": "5.2.2",
    "ip": "^2.0.1",
    "reflect-metadata": "0.2.2",
    "tailwindcss": "^4.1.13",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.8.16",
    "typescript-eslint": "8.45.0",
    "vite": "7.3.7",
    "vite-plugin-static-copy": "3.1.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "git-commit-msg": "0.3.0",
    "prisma": "^6.16.3",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.0"
  },
  "git-commit-hook": {
    "types": [
      "feat",
      "fix",
      "chore",
      "merge"
    ],
    "lineLength": 120
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22.17.1",
    "os": "!win32"
  }
}
