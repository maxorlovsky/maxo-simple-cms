{
  "name": "maxo-simple-cms",
  "description": "Maxo's Simple CMS",
  "version": "6.0.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxorlovsky/maxo-simple-cms"
  },
  "workspaces": [
    "ui",
    "api"
  ],
  "scripts": {
    "ui:lint": "cd ui && npm run eslint && npm run tsc",
    "ui:stylelint": "stylelint \"./ui/**/*.(vue)\"",
    "ui:release": "git pull && npm install && cd ui && npm run build",
    "ui": "cd ui && npm run ui",
    "api:lint": "eslint --no-warn-ignored ./api/src/**/*.ts",
    "api:release": "cd api && npm run release",
    "api:migrations:create": "./scripts/typeorm-migration-game.sh",
    "api:migrations": "node_modules/.bin/ts-node --project ./api/tsconfig.json ./node_modules/typeorm/cli.js migration:run -d ./scripts/typeorm-datasource-game",
    "api": "cd api && npm run be",
    "clean-branches": "git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/parser": "8.38.0",
    "@vitejs/plugin-vue": "6.0.0",
    "@vue/compiler-sfc": "3.5.18",
    "@vueuse/core": "13.5.0",
    "axios": "1.12.0",
    "bcrypt": "6.0.0",
    "bootstrap": "5.3.7",
    "date-fns": "4.1.0",
    "discord.js": "14.21.0",
    "eslint": "9.32.0",
    "eslint-plugin-vue": "9.33.0",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "firebase": "12.0.0",
    "fireworks-js": "2.10.8",
    "floating-vue": "5.2.2",
    "lodash.isequal": "4.5.0",
    "lodash.merge": "4.6.2",
    "lodash.mergewith": "4.6.2",
    "mysql": "2.18.1",
    "mysql2": "3.14.2",
    "nodemailer": "7.0.5",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "striptags": "3.2.0",
    "stylelint": "16.22.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "38.0.0",
    "tailwindcss": "^4.1.13",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.8.16",
    "typeorm": "0.3.25",
    "typescript-eslint": "8.38.0",
    "vite": "7.1.5",
    "vite-plugin-static-copy": "3.1.2",
    "vue": "3.5.18",
    "vue-3-slider-component": "1.0.2",
    "vue-draggable-next": "2.2.1",
    "vue-gtag": "3.5.2",
    "vue-router": "4.5.1",
    "vue-toggles": "2.1.0",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "git-commit-msg": "0.3.0",
    "husky": "9.1.7",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "vue-tsc": "3.0.4"
  },
  "git-commit-hook": {
    "types": [
      "feat",
      "fix",
      "chore",
      "merge"
    ],
    "lineLength": 120
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22.17.1",
    "os": "!win32"
  }
}
