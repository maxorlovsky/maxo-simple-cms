{
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/node_modules": true,
        "**/public": true
    },
    "git.ignoreLimitWarning": true,
    "git.inputValidationSubjectLength": 120,
    "eslint.validate": [
        "javascript",
        "vue",
        "typescript"
    ],
    "stylelint.validate": [
        "scss",
        "vue"
    ],
    "typescript.tsdk": "node_modules/typescript/lib",
    "search.exclude": {
        "**/api/db/migration": true,
        "**/package-lock.json": true,
        "**/tmp": true
    },
    "files.watcherExclude": {
        "**/public": true,
        "**/node_modules": true,
        "**/package-lock.json": true
    }
}