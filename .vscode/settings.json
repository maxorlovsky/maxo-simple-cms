{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/public": true
  },
  "git.ignoreLimitWarning": true,
  "git.inputValidationSubjectLength": 120,
  "eslint.validate": [
    "javascript",
    "vue",
    "typescript"
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "search.exclude": {
    "**/api/db/migration": true,
    "**/package-lock.json": true,
    "**/tmp": true
  },
  "files.watcherExclude": {
    "**/public": true,
    "**/node_modules": true,
    "**/package-lock.json": true
  },

  // Editor indentation settings — enforce 2 spaces across the workspace
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Language specific overrides
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  "[vue]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.tabSize": 2
  }
}