{
   "extends": "../tsconfig.json",
   "compilerOptions": {
      "lib": [
         "ES2022"
      ],
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "baseUrl": ".",
      "rootDirs": [
         "..",
         "shared"
      ],
      "outDir": "./public",
      "paths": {
         "@entity/*": ["./db/entity/*"],
         "@src/*": ["./src/*"],
         "@helpers/*": ["./src/helpers/*"],
         "@inc/*": ["./src/inc/*"],
         "@modules/*": ["./src/modules/*"],
         "@routes/*": ["./src/routes/*"],
         "@shared/*": ["../shared/*"],
         "@prisma/*": ["./generated/prisma/*"]
      },
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "sourceMap": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "disableReferencedProjectLoad": true,
      "disableSolutionSearching": true
   },
   "ts-node": {
      "transpileOnly": true,
      "require": ["tsconfig-paths/register"],
   },
   "include": [
      "./src/**/*.ts",
      "./db/**/*.ts",
   ],
   "exclude": [
      "./api/src/**/*.json",
   ]
}